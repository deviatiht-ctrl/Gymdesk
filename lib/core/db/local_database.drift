CREATE TABLE records (
  entity TEXT NOT NULL,
  id TEXT NOT NULL,
  gym_id TEXT NOT NULL,
  payload TEXT NOT NULL CHECK (json_valid(payload)),
  server_version TEXT,
  deleted_at TEXT,
  PRIMARY KEY (entity, id)
);
CREATE INDEX records_tenant ON records(gym_id, entity, deleted_at);
CREATE INDEX members_name ON records(entity, gym_id, json_extract(payload, '$.last_name'), id);
CREATE INDEX members_token ON records(entity, gym_id, json_extract(payload, '$.qr_token'));
CREATE INDEX subscriptions_member ON records(entity, gym_id, json_extract(payload, '$.member_id'), json_extract(payload, '$.end_date'));
CREATE INDEX badges_number ON records(entity, gym_id, json_extract(payload, '$.badge_number'));
CREATE INDEX badges_token ON records(entity, gym_id, json_extract(payload, '$.qr_token'));
CREATE INDEX badges_status ON records(entity, gym_id, json_extract(payload, '$.status'));
CREATE INDEX member_pins_member ON records(entity, gym_id, json_extract(payload, '$.member_id'));

CREATE TABLE outbox (
  sequence INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  id TEXT NOT NULL UNIQUE,
  entity TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  operation TEXT NOT NULL CHECK (operation IN ('insert', 'update', 'delete')),
  payload TEXT NOT NULL CHECK (json_valid(payload)),
  base_version TEXT,
  changed_at TEXT NOT NULL,
  created_at TEXT NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0,
  next_attempt_at TEXT,
  last_error TEXT,
  status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'synced', 'failed'))
);
CREATE INDEX outbox_pending ON outbox(status, sequence);
CREATE INDEX outbox_entity ON outbox(entity, entity_id, status);

CREATE TABLE sync_metadata (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE number_blocks (
  id TEXT NOT NULL PRIMARY KEY,
  prefix TEXT NOT NULL,
  next_value INTEGER NOT NULL,
  last_value INTEGER NOT NULL
);

CREATE TABLE photo_uploads (
  id TEXT NOT NULL PRIMARY KEY,
  member_id TEXT NOT NULL,
  object_path TEXT NOT NULL,
  bytes BLOB NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0,
  next_attempt_at TEXT,
  last_error TEXT
);

CREATE TABLE sync_conflicts (
  id TEXT NOT NULL PRIMARY KEY,
  entity TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  local_payload TEXT NOT NULL,
  server_payload TEXT NOT NULL,
  created_at TEXT NOT NULL,
  reviewed INTEGER NOT NULL DEFAULT 0
);
